{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flame-in-freefall.local/schema/source-registry-v1.json",
  "title": "Flame in Freefall Source Registry",
  "description": "Day-1 source-level registry for NASA microgravity combustion/fire-safety data sources.",
  "type": "object",
  "required": ["source_id","title","provider","repository","source_type","access_status","priority"],
  "properties": {
    "source_id": {"type":"string","pattern":"^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "title": {"type":"string","minLength":1},
    "short_name": {"type":["string","null"]},
    "provider": {"type":"string"},
    "repository": {"enum":["NASA PSI","NASA NTRS","NASA Science","NASA Open Data","NASA GRC FCF","Other"]},
    "psi_id": {"type":["string","null"]},
    "persistent_identifier": {"type":["string","null"]},
    "source_type": {"enum":["investigation_dataset","technical_report","publication_corpus","media_dataset","supporting_documentation"]},
    "experiment_family": {"type":["string","null"]},
    "flight_platform": {"type":["string","null"]},
    "data_modalities": {"type":"array","items":{"type":"string"}},
    "primary_fire_safety_use": {"type":"array","items":{"type":"string"}},
    "key_variables": {"type":"array","items":{"type":"string"}},
    "key_outputs": {"type":"array","items":{"type":"string"}},
    "license": {"type":["string","null"]},
    "access_status": {"enum":["confirmed_public","public_page_verified_download_path_pending","reference_only","unknown"]},
    "access_url": {"type":"string","format":"uri"},
    "data_access_url": {"type":["string","null"],"format":"uri"},
    "aws_bucket": {"type":["string","null"]},
    "version": {"type":["string","null"]},
    "last_verified_utc": {"type":"string","format":"date-time"},
    "source_date_range": {"type":["string","null"]},
    "known_file_count": {"type":["integer","null"],"minimum":0},
    "known_size": {"type":["string","null"]},
    "ingestion_strategy": {"enum":["metadata_then_tabular_then_media","metadata_then_media","document_first","defer"]},
    "notes": {"type":"string"},
    "provenance_requirements": {"type":"array","items":{"type":"string"}},
    "priority": {"enum":["P0","P1","P2"]},
    "p0_candidate_reason": {"type":["string","null"]},
    "verification_state": {"enum":["verified","partially_verified","needs_followup"]}
  },
  "additionalProperties": false
}
