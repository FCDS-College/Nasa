{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PassageGoldCase",
  "description": "One question with page-level evidence, for scoring retrieval and, later, answers. Rules that a schema cannot express (document-disjoint splits, evidence text equal to the page text, at least 25% unanswerable, a verifier other than the author) are enforced by ai/rag/evaluation/passage_gold.py `validate`. See docs/evaluation/annotation-guidelines.md section 5.",
  "type": "object",
  "properties": {
    "gold_id": { "type": "string", "pattern": "^PG-[0-9]{3,}$" },
    "split": { "type": "string", "enum": ["dev", "validation", "holdout"] },
    "question": { "type": "string", "minLength": 10 },
    "answerable": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "page": { "type": "integer", "minimum": 1 },
          "char_start": { "type": "integer", "minimum": 0 },
          "char_end": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 }
        },
        "required": ["document_id", "page", "char_start", "char_end", "text"],
        "additionalProperties": false
      }
    },
    "question_type": { "type": "string", "enum": ["value_lookup", "condition", "comparison", "definition", "procedure", "other"] },
    "unanswerable_kind": { "type": ["string", "null"], "enum": ["out_of_domain", "in_domain_not_in_corpus", null] },
    "author": { "type": "string", "minLength": 1 },
    "verified_by": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "type": "string", "enum": ["draft", "verified"] }
  },
  "required": ["gold_id", "split", "question", "answerable", "evidence", "question_type", "unanswerable_kind", "author", "verified_by", "status"],
  "additionalProperties": false
}
