{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoAnalysisResult v1.2.0",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "default": "1.2.0" },
    "status": { "type": "string", "enum": ["SUCCESS", "ERROR"] },
    "analysisId": { "type": "string" },
    "videoId": { "type": "string" },
    "pipelineVersion": { "type": "string" },
    "videoMetadata": {
      "type": "object",
      "properties": {
        "fps": { "type": "number" },
        "frameCount": { "type": "integer" },
        "durationSeconds": { "type": "number" },
        "resolution": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["fps", "frameCount", "durationSeconds", "resolution"]
    },
    "frameMeasurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frameIndex": { "type": "integer" },
          "timestamp": { "type": "number" },
          "detectionStatus": { "type": "string", "enum": ["PRESENT", "ABSENT", "UNCERTAIN"] },
          "pixelArea": { "type": ["number", "null"] }
        },
        "required": ["frameIndex", "timestamp", "detectionStatus"]
      }
    },
    "temporalSummary": {
      "type": "object",
      "properties": {
        "persistenceRate": { "type": "number" },
        "flickerFrequencyHz": { "type": ["number", "string"] }
      },
      "required": ["persistenceRate", "flickerFrequencyHz"]
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "summaryUri": { "type": "string" },
        "checksum": { "type": "string" }
      }
    }
  },
  "required": ["schemaVersion", "status", "analysisId", "videoId", "pipelineVersion", "videoMetadata", "frameMeasurements", "temporalSummary"]
}