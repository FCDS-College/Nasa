# Local development only. Set private values before sharing a network.
POSTGRES_PASSWORD=flame-local-only
MINIO_ROOT_USER=flame-local
MINIO_ROOT_PASSWORD=flame-local-only-change-me
API_PORT=8000
FLAME_API_AUTH_ENABLED=true
# Deprecated: give each caller its own key instead (python -m flame_api.clients create NAME --scopes read).
# Both are optional; when set they still work, must be >= 32 characters and must differ.
FLAME_READ_API_TOKEN=REPLACE_ME_READ_TOKEN
FLAME_WRITE_API_TOKEN=REPLACE_ME_WRITE_TOKEN
# Per-client rate limits in Redis for /api/* (not /api/health). Fails open if Redis is down.
FLAME_RATE_LIMIT_ENABLED=true
FLAME_READ_RATE_LIMIT_PER_MINUTE=600
FLAME_WRITE_RATE_LIMIT_PER_MINUTE=60
FLAME_CHAT_RATE_LIMIT_PER_MINUTE=30
# production refuses the local-only S3 and database defaults above (P2-6).
# FLAME_ENVIRONMENT=production
FLAME_AURA_ENABLED=false
FLAME_AURA_BASE_URL=https://aura-ai-production-03a4.up.railway.app
FLAME_AURA_SERVICE_TOKEN=replace-with-AURA-svc-flame-token
# true refuses any AURA model that is not on AURA's own host. Set false when AURA's only model is a
# self-hosted GPU Space (AURA counts that as remote), or every call fails with all_providers_failed.
FLAME_AURA_REQUIRE_LOCAL=true
# Optional remote CV inference using a private Hugging Face Space.
FLAME_CV_PROVIDER=local
FLAME_CV_HF_SPACE_URL=
FLAME_CV_HF_TOKEN=
FLAME_CV_TIMEOUT_S=300
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# --- Sub-phase 2H: model routing (docs/hybrid-ai/PHASE_2_HYBRID_AI_ARCHITECTURE.md) ---
# cloud_preferred | local_first | offline_only. offline_only never contacts AURA or the HF Space.
FLAME_AI_EXECUTION_MODE=local_first
# Local LLM. With COMPOSE_PROFILES=local-llm use http://ollama:11434. Empty = no local LLM.
FLAME_OLLAMA_BASE_URL=
FLAME_OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# Optional GPU server on the same network (vLLM on the L40S) and llama.cpp llama-server.
FLAME_VLLM_BASE_URL=
FLAME_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
FLAME_LLAMACPP_BASE_URL=
FLAME_LLM_TIMEOUT_S=180
# true = never download embedding weights; a missing model is reported, not fetched.
FLAME_EMBEDDING_OFFLINE=false
FLAME_OTEL_ENABLED=false
COMPOSE_PROFILES=
