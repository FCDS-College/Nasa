# Mirrored source data: immutable originals live outside Git (see docs/data/DAY1_DATA_ACQUISITION.md)
datasets/raw/**
# ...except the small CC0 PSI experimental tables and ISA-Tab metadata (~130 KB; ADR-012): the experiment
# workflow, the investigation dashboard and the FLEX outcome model need them on every clone.
!datasets/raw/**/
!datasets/raw/psi_api/*/Experimental table/*.csv
!datasets/raw/psi_api/*/metadata/*.zip
# Full nasa-psi bucket listing is ~110 MB (over GitHub's 100 MB limit); regenerate with `aws s3 ls --recursive`
datasets/manifests/nasa_psi_full_listing.txt
__pycache__/
# Derived artefacts (frame extractions, conversions) are rebuilt from raw; keep them out of Git
datasets/derived/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.ipynb_checkpoints/
data/raw/
data/processed/

# CV generated outputs and offline wheels
cv/output/
cv/weights/
*.egg-info/

# Redis snapshot written by a local redis-server started from the repo root
dump.rdb

# Local Codex config (a personal Figma MCP setup), never shared
.codex/
