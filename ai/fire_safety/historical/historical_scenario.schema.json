{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical_scenario.schema.json",
  "title": "Historical cabin-atmosphere scenario",
  "description": "A past spacecraft atmosphere (usually an incident) used to show what the flight data can and cannot say. Every statement shown to a user carries an NTRS source ID and page. Loaded by ai/fire_safety/scenarios.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "name", "year", "o2_fraction", "pressure_kpa", "gravity", "note", "citation",
               "story", "lesson", "lesson_sources", "timeline", "alternative"],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "page"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^FF-NTRS-[0-9]{11}$"},
        "page": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 10}
      }
    }
  },
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9_]{3,40}$"},
    "name": {"type": "string", "minLength": 3, "maxLength": 80},
    "year": {"type": "integer", "minimum": 1957, "maximum": 2100},
    "o2_fraction": {"type": "number", "minimum": 0.05, "maximum": 1.0},
    "pressure_kpa": {"type": "number", "minimum": 5, "maximum": 400},
    "gravity": {"enum": ["microgravity", "lunar", "martian", "earth"]},
    "note": {"type": "string", "minLength": 10},
    "citation": {"type": "string", "minLength": 10},
    "story": {"type": "string", "minLength": 20},
    "lesson": {"type": "string", "minLength": 20},
    "lesson_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "title", "text", "sources"],
        "properties": {
          "date": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 10},
          "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "headline", "rationale", "sources"],
      "properties": {
        "scenario_id": {"type": "string"},
        "headline": {"type": "string", "minLength": 5},
        "rationale": {"type": "string", "minLength": 20},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
